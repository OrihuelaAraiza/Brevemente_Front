# ─── BreveMente — Frontend ───
VITE_BRAND=brevemente

# En dev: /api (proxy de Vite hacia Brevemente_Api en :4002)
# En prod: URL absoluta de la API de BreveMente
VITE_API_BASE_URL=/api
VITE_API_URL=/api

# MSAL opcional (solo si se habilita login con Microsoft)
VITE_MSAL_CLIENT_ID=<GUID>
VITE_MSAL_TENANT_ID=common
VITE_MSAL_REDIRECT_URI=http://localhost:5175/
